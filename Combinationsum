import java.util.*;

public class CombinationSum {
    static void dfs(int[] a, int t, int i, List<Integer> cur, List<List<Integer>> res) {
        if (t == 0) { res.add(new ArrayList<>(cur)); return; }
        if (i == a.length || t < 0) return;

        cur.add(a[i]);
        dfs(a, t - a[i], i, cur, res);
        cur.remove(cur.size()-1);
        dfs(a, t, i+1, cur, res);
    }

    public static void main(String[] args) {
        int[] a = {2,3,6,7};
        List<List<Integer>> res = new ArrayList<>();
        dfs(a, 7, 0, new ArrayList<>(), res);
        System.out.println(res);
    }
}
